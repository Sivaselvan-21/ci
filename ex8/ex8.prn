import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.preprocessing import LabelEncoder
from sklearn.metrics import confusion_matrix, accuracy_score, precision_score, f1_score

# 1. Load your CSV file
# Ensure 'job_data.csv' is in your working directory
df = pd.read_csv('data.csv')

# 2. Encode categorical data to numeric
encoder = LabelEncoder()
for col in df.columns:
    df[col] = encoder.fit_transform(df[col])

# 3. Define features (X) and target (y)
X = df.iloc[:, :-1].values  # All columns except the last
y = df.iloc[:, -1].values   # The 'Job' column

# 4. User-defined tree count and fixed split ratio (e.g., 70-30)
tree_count = int(input("Enter the number of decision trees for the forest: "))
split_percentage = 0.30  # Change this to 0.40 for a 60-40 split

# 5. Split the data
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=split_percentage, random_state=42)

# 6. Build the Random Forest model
model = RandomForestClassifier(n_estimators=tree_count, random_state=42)
model.fit(X_train, y_train)

# 7. Make predictions
y_pred = model.predict(X_test)

# 8. Calculate Metrics
acc = accuracy_score(y_test, y_pred)
prec = precision_score(y_test, y_pred)
f1 = f1_score(y_test, y_pred)

# 9. Extract Confusion Matrix values
tn, fp, fn, tp = confusion_matrix(y_test, y_pred).ravel()

print("\n--- Model Performance ---")
print(f"Accuracy:  {acc:.2f}")
print(f"Precision: {prec:.2f}")
print(f"F1-Score:  {f1:.2f}")

print("\n--- Confusion Matrix Details ---")
print(f"True Negative (TN):  {tn}")
print(f"True Positive (TP):  {tp}")
print(f"False Negative (FN): {fn}")
print(f"False Positive (FP): {fp}")

